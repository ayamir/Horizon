  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-pro",
    "api_key_env": "HORIZON_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 6,
    "enrichment_concurrency": 4,
    "languages": [
      "en",
      "zh"
    ]
