  "digest": {
    "max_items": 12,
    "profile_order": [
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {
      "agents": {
        "name": "AI Agents",
        "limit": 5,
        "categories": [
          "ai-agents"
        ]
      },
      "infra": {
        "name": "LLM Infra",
        "limit": 4,
        "categories": [
          "ai-infra",
          "llm-inference",
          "ai-research",
          "cuda"
        ]
      },
      "langs": {
        "name": "Languages",
        "limit": 1,
        "categories": [
          "rust-go"
        ]
      },
      "oss": {
        "name": "Open Source Tools",
        "limit": 1,
        "categories": [
          "oss-tools",
          "ai-tools",
          "software-engineering"
        ]
      },
      "other": {
        "name": "Other Tech",
        "limit": 3,
        "categories": [
          "ai-tech"
        ]
      },
      "finance": {
        "name": "Finance",
        "limit": 1,
        "categories": [
          "finance"
        ]
      }
    },
